# Copy this file to .env and fill in your values
OPENAI_API_KEY=your_openai_api_key_here

# Pipeline LLM (per-ticker + digest). Defaults to gpt-4o-mini if unset.
# Set explicitly to avoid sharing an expensive OPENCLAW_MODEL with daily runs.
STOCKMONKEY_OPENAI_MODEL=gpt-4o-mini

# OpenClaw agent / chat (optional). Does not override STOCKMONKEY_OPENAI_MODEL for this repo.
# OPENCLAW_MODEL=gpt-5.4

DEFAULT_TICKERS=AAPL,NVDA,TSLA
TIMEZONE=America/Los_Angeles

# After each brief, git commit + push dashboard files so GitHub Pages matches Telegram
STOCKMONKEY_AUTO_PUSH=1
# STOCKMONKEY_GIT_BRANCH=main
